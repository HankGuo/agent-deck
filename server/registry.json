{
  "version": 1,
  "workspace": "./workspace",
  "uploads": "./uploads",
  "outputs": "./outputs",
  "contextDir": "./context",
  "limits": {
    "maxConcurrentRuns": 2,
    "maxConcurrentPerAgent": 1,
    "promptTimeoutMs": 600000,
    "agentIdleReapMs": 900000,
    "maxUploadBytes": 104857600,
    "maxRunsPerHour": 120,
    "queueTimeoutMs": 90000
  },
  "fsAllow": [
    "./workspace",
    "./uploads",
    "./outputs",
    "./context",
    "/tmp"
  ],
  "agents": [
    {
      "id": "antigravity",
      "key": "ag",
      "name": "Antigravity",
      "short": "AG",
      "color": "#2E5C8C",
      "protocol": "ndjson",
      "cmd": [
        "agy",
        "--output-format",
        "stream-json",
        "--dangerously-skip-permissions"
      ],
      "needsPromptArg": true,
      "model": "Gemini 3.8 Flash (High)",
      "capability": "账龄计算 / 催款函生成 / 图像生成",
      "abilities": [
        "图像生成",
        "图片理解",
        "文件读写",
        "命令执行",
        "联网检索",
        "浏览器操作"
      ],
      "keywords": [
        "账龄",
        "催款",
        "aging",
        "对账",
        "核销",
        "报表",
        "图片",
        "配图",
        "封面",
        "图",
        "截图",
        "网页",
        "浏览器"
      ],
      "bestFor": "结构化数据计算 + 出图 + 需要浏览器/联网的活儿",
      "identity": {
        "name": "Antigravity",
        "role": "结构化数据计算、账龄与报表口径、图像生成、联网检索与浏览器操作",
        "strengths": [
          "账龄测算与分层",
          "坏账核销",
          "预收/首笔款/重分类报表",
          "数据对账与差异核对",
          "图像生成",
          "封面图与配图",
          "截图",
          "联网检索",
          "浏览器抓取"
        ],
        "avoid": [
          "公众号与小红书文案",
          "对外客户沟通话术",
          "长文档逐条抽取"
        ],
        "notes": "涉及金额一律保留两位小数;账龄必须写明基准日和计算口径。"
      },
      "cwd": "./agents-ws",
      "note": "独立 workspace:它的 .agents/agents/ 定义不能被 Kimi 扫到",
      "logo": "/logos/antigravity.png"
    },
    {
      "id": "kimi",
      "key": "ki",
      "name": "Kimi Code",
      "short": "KI",
      "color": "#2E7A5B",
      "protocol": "acp",
      "cmd": [
        "kimi",
        "acp"
      ],
      "model": "Kimi K2.8 Preview · 1M 上下文",
      "capability": "超大文件读取 / 长文档分析",
      "abilities": [
        "超大文件读取",
        "长文档分析",
        "图片理解",
        "视频理解",
        "联网检索"
      ],
      "keywords": [
        "大文件",
        "读取",
        "读表",
        "表",
        "excel",
        "xlsx",
        "csv",
        "核对",
        "对表",
        "汇总台账",
        "台账",
        "逐条",
        "清单",
        "长文档",
        "pdf"
      ],
      "bestFor": "大表/长文档完整载入后做核对与抽取",
      "identity": {
        "name": "Kimi Code",
        "role": "超大文件完整读取、长文档分析、逐条核对与结构化抽取",
        "strengths": [
          "大表完整载入",
          "超长表格",
          "PDF 合同",
          "逐条核对",
          "差异清单",
          "对账",
          "台账汇总",
          "长文档分析",
          "合同条款提取",
          "1M 上下文"
        ],
        "avoid": [
          "对外文案创作",
          "图像生成",
          "定时批量作业"
        ],
        "notes": "处理大表时优先用脚本把表转成中间结构,不要硬塞进上下文。"
      },
      "logo": "/logos/kimi.png"
    },
    {
      "id": "minimax",
      "key": "mm",
      "name": "MiniMax Code",
      "short": "MM",
      "color": "#9C6B15",
      "protocol": "acp",
      "cmd": [
        "mcode",
        "acp"
      ],
      "model": "MiniMax M3.1 Flash (thinking)",
      "capability": "定时批处理 / 文档与页面产出",
      "abilities": [
        "文档生成",
        "页面生成",
        "批量处理",
        "定时执行",
        "图片理解",
        "命令执行"
      ],
      "keywords": [
        "写",
        "文案",
        "说明",
        "生成",
        "页面",
        "html",
        "小程序",
        "批量",
        "定时",
        "每天",
        "每周",
        "报告",
        "文档",
        "docx"
      ],
      "bestFor": "写文档/做页面/批量可重复的作业",
      "identity": {
        "name": "MiniMax Code",
        "role": "文档与页面产出、对外文案、可重复的批量作业",
        "strengths": [
          "公众号稿",
          "小红书文案",
          "复盘总结",
          "客户话术",
          "标题起名",
          "单页应用与可视化页面",
          "Word/Excel 成品交付",
          "批量与定时作业",
          "排版节奏"
        ],
        "avoid": [
          "账龄计算",
          "超大表逐条读取",
          "图像生成"
        ],
        "notes": "交付物一律存到 ./outputs/,文件名带全业务要素。"
      },
      "logo": "/logos/minimax.png"
    }
  ],
  "tools": [
    {
      "id": "t1",
      "n": "账龄分析器",
      "s": "10/19 修改",
      "tag": "3",
      "c": "#2E5C8C",
      "icon": "chart",
      "src": "财务",
      "agent": "antigravity",
      "rules": [
        "账龄按自然年划分,基准日=月末",
        "超 90 天高亮标注,金额保留两位小数"
      ],
      "starter": "用 ./uploads/ 里的最新账龄表算 10 月账龄,基准日=月末,账龄按自然年划分,超 90 天高亮标注,金额保留两位小数。产出 Excel 存到 ./outputs/。"
    },
    {
      "id": "t2",
      "n": "催款函生成器",
      "s": "v1.8 · 10/19",
      "tag": "v1.8",
      "c": "#2E7A5B",
      "icon": "doc",
      "src": "财务",
      "agent": "minimax",
      "rules": [
        "催款函正文仿宋,标题 15pt 加粗,高亮需为真实高亮",
        "文件名含文号+客户全称+项目编号",
        "仅做微调,不整体重构"
      ],
      "starter": "按 ./outputs/ 里的旧催款函模板,给指定客户出一份催款函。正文仿宋,标题 15pt 加粗,标黄必须是真 Word 高亮,文件名含文号+客户全称+项目编号,只做微调不整体重构。产出 docx 存到 ./outputs/。"
    },
    {
      "id": "t3",
      "n": "客户账期异常监控",
      "s": "10/21",
      "tag": "新",
      "c": "#9C6B15",
      "icon": "bell",
      "src": "财务",
      "agent": "antigravity",
      "rules": [
        "金额保留两位小数"
      ],
      "starter": "检查 ./uploads/ 里各客户账期是否异常,列出偏离标准账期的客户和金额,产出表格存到 ./outputs/。"
    },
    {
      "id": "t4",
      "n": "项目台账汇总",
      "s": "10/20",
      "tag": "",
      "c": "#5A6068",
      "icon": "grid",
      "src": "财务",
      "agent": "kimi",
      "rules": [
        "仅做微调,不整体重构"
      ],
      "starter": "把 ./uploads/ 里的项目台账完整读进来,汇总成一张总表,产出 Excel 存到 ./outputs/。"
    },
    {
      "id": "t5",
      "n": "开票对账小助手",
      "s": "已上线",
      "tag": "线上",
      "c": "#8C9299",
      "icon": "check",
      "src": "财务",
      "agent": "kimi",
      "rules": [
        "金额保留两位小数"
      ],
      "starter": "用发票与回款记录做逐条对账,标出金额不一致的,产出核对结果表存到 ./outputs/。"
    },
    {
      "id": "t6",
      "n": "小红书选题池",
      "s": "10 月 · 分三档",
      "tag": "5",
      "c": "#2E5C8C",
      "icon": "bulb",
      "src": "内容",
      "agent": "minimax",
      "rules": [
        "人设:平实、口语化",
        "开头先给结论",
        "少用「赋能/闭环/抓手」",
        "先给情绪,再给方法"
      ],
      "starter": "围绕本月主题给 5 个小红书选题,每个先给情绪再给方法,开头先给结论,口语化,别用「赋能/闭环/抓手」。"
    },
    {
      "id": "t7",
      "n": "封面图工坊",
      "s": "3:4 · 文字不压脸",
      "tag": "",
      "c": "#2E7A5B",
      "icon": "image",
      "src": "内容",
      "agent": "antigravity",
      "rules": [
        "配图 3:4,文字不压脸"
      ],
      "starter": "给这期内容配一张 3:4 封面图,文字不要压脸,产出图片存到 ./outputs/。"
    },
    {
      "id": "t8",
      "n": "公众号深度长文",
      "s": "每两周 1 篇",
      "tag": "",
      "c": "#9C6B15",
      "icon": "pen",
      "src": "内容",
      "agent": "minimax",
      "rules": [
        "人设:平实、口语化",
        "不写「作为 AI 我认为」"
      ],
      "starter": "写一篇公众号稿,平实口语化,不要写「作为 AI 我认为」。"
    },
    {
      "id": "t9",
      "n": "周末去哪儿",
      "s": "成都 · 有山有咖啡",
      "tag": "",
      "c": "#5A6068",
      "icon": "map",
      "src": "生活",
      "agent": "kimi",
      "rules": [],
      "starter": "成都周边找一个有山有咖啡的地方,周末能去,给出具体路线。"
    }
  ],
